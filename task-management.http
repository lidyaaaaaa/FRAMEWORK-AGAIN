@baseUrl = http://localhost:3000
@runId = 1
@futureDate = 2026-12-31
@teamId = ganti-dengan-id-dari-response
@team2Id = ganti-dengan-id-dari-response
@memberAId = ganti-dengan-id-dari-response
@memberBId = ganti-dengan-id-dari-response
@memberCId = ganti-dengan-id-dari-response
@projectId = ganti-dengan-id-dari-response
@taskId = ganti-dengan-id-dari-response
@task2Id = ganti-dengan-id-dari-response
@assignmentId = ganti-dengan-id-dari-response
@assignment2Id = ganti-dengan-id-dari-response

# Catatan: file ini hanya contoh request manual. Untuk skenario lengkap gunakan Postman Collection.
# Ganti {{...}} dengan id asli dari response sebelumnya.

### 00 - Health Check - GET / (aplikasi hidup)
GET {{baseUrl}}/

### 01 - Teams - Create team (sukses)
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "name": "Tim Backend {{runId}}",
  "description": "Tim pengembang API"
}

### 01 - Teams - Create team kedua (sukses)
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "name": "Tim Frontend {{runId}}"
}

### 01 - Teams - Create team - nama duplikat (409)
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "name": "Tim Backend {{runId}}"
}

### 01 - Teams - Create team - nama kosong (400)
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "name": ""
}

### 01 - Teams - Create team - field tidak dikenal (400)
POST {{baseUrl}}/teams
Content-Type: application/json

{
  "name": "X",
  "foo": "bar"
}

### 01 - Teams - Get all teams
GET {{baseUrl}}/teams

### 01 - Teams - Get team by id
GET {{baseUrl}}/teams/{{teamId}}

### 01 - Teams - Get team - id tidak ditemukan (404)
GET {{baseUrl}}/teams/00000000-0000-4000-8000-000000000000

### 01 - Teams - Get team - format id salah (400)
GET {{baseUrl}}/teams/bukan-uuid

### 01 - Teams - Update team (sukses)
PATCH {{baseUrl}}/teams/{{teamId}}
Content-Type: application/json

{
  "description": "Tim pengembang API (diperbarui)"
}

### 01 - Teams - Update team - nama bentrok (409)
PATCH {{baseUrl}}/teams/{{teamId}}
Content-Type: application/json

{
  "name": "Tim Frontend {{runId}}"
}

### 01 - Teams - Update team - id tidak ditemukan (404)
PATCH {{baseUrl}}/teams/00000000-0000-4000-8000-000000000000
Content-Type: application/json

{
  "name": "Apa saja"
}

